digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.1, label="ER-діаграма: прогнозування покупки (e-commerce)", labelloc=t, fontsize=18];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  subgraph cluster_biz {
    label="Бізнесові сутності"; style=rounded; color="#4a7bd0";
    customers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#dbe6fb"><b>hw2_customers</b></td></tr>
      <tr><td align="left">PK customer_id BIGINT</td></tr>
      <tr><td align="left">email VARCHAR(255) UNIQUE</td></tr>
      <tr><td align="left">signup_date DATE</td></tr>
      <tr><td align="left">country CHAR(2)</td></tr>
      <tr><td align="left">is_active BOOLEAN</td></tr></table>>];
    orders [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#dbe6fb"><b>hw2_orders</b></td></tr>
      <tr><td align="left">PK order_id BIGINT</td></tr>
      <tr><td align="left">FK customer_id BIGINT</td></tr>
      <tr><td align="left">order_ts TIMESTAMPTZ</td></tr>
      <tr><td align="left">status VARCHAR(20)</td></tr></table>>];
    order_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#dbe6fb"><b>hw2_order_items</b> (bridge)</td></tr>
      <tr><td align="left">PK, FK order_id BIGINT</td></tr>
      <tr><td align="left">PK, FK product_id BIGINT</td></tr>
      <tr><td align="left">quantity INTEGER</td></tr>
      <tr><td align="left">unit_price NUMERIC(10,2)</td></tr></table>>];
    products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#dbe6fb"><b>hw2_products</b></td></tr>
      <tr><td align="left">PK product_id BIGINT</td></tr>
      <tr><td align="left">title TEXT</td></tr>
      <tr><td align="left">category VARCHAR(50)</td></tr>
      <tr><td align="left">price NUMERIC(10,2)</td></tr></table>>];
  }

  subgraph cluster_off {
    label="Offline-рівень feature store"; style=rounded; color="#d08a2a";
    feat_off [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#fbe8cf"><b>hw2_customer_features_offline</b></td></tr>
      <tr><td align="left">PK, FK customer_id BIGINT</td></tr>
      <tr><td align="left">PK valid_from TIMESTAMPTZ</td></tr>
      <tr><td align="left">valid_to TIMESTAMPTZ NULL</td></tr>
      <tr><td align="left">orders_30d INTEGER</td></tr>
      <tr><td align="left">avg_order_value NUMERIC(12,2)</td></tr>
      <tr><td align="left">days_since_last_order INTEGER</td></tr>
      <tr><td align="left">top_category VARCHAR(50)</td></tr></table>>];
    events [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#fbe8cf"><b>hw2_training_events</b></td></tr>
      <tr><td align="left">PK event_id BIGINT</td></tr>
      <tr><td align="left">FK customer_id BIGINT</td></tr>
      <tr><td align="left">prediction_ts TIMESTAMPTZ</td></tr>
      <tr><td align="left">label_horizon_end TIMESTAMPTZ</td></tr>
      <tr><td align="left">purchased_in_horizon BOOLEAN</td></tr></table>>];
  }

  subgraph cluster_on {
    label="Online-рівень feature store"; style=rounded; color="#3a9a5b";
    feat_on [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#d6f0de"><b>hw2_customer_features_online</b></td></tr>
      <tr><td align="left">PK, FK customer_id BIGINT</td></tr>
      <tr><td align="left">country CHAR(2)</td></tr>
      <tr><td align="left">orders_30d INTEGER</td></tr>
      <tr><td align="left">avg_order_value NUMERIC(12,2)</td></tr>
      <tr><td align="left">days_since_last_order INTEGER</td></tr>
      <tr><td align="left">top_category VARCHAR(50)</td></tr>
      <tr><td align="left">feature_ts TIMESTAMPTZ</td></tr>
      <tr><td align="left">updated_at TIMESTAMPTZ</td></tr></table>>];
  }

  customers -> orders [label="1 (обов.) : 0..N"];
  orders -> order_items [label="1 : 1..N"];
  products -> order_items [label="1 : 0..N"];
  customers -> feat_off [label="1 : 0..N версій"];
  customers -> events [label="1 : 0..N"];
  customers -> feat_on [label="1 : 0..1"];
  feat_off -> feat_on [style=dashed, label="materialize\nvalid_to IS NULL"];
}
